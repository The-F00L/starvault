# Optional for local dev: a fine-grained PAT from a dedicated machine account, with NO permissions ("Public repositories" read-only).
# Enables GitHub Lists and raises rate limits for the /api proxy. Never prefix with VITE_.
GITHUB_TOKEN=

# --- Self-hosted mode only (docker compose / npm run selfhost) ---
# GITHUB_TOKEN above must then be YOUR fine-grained token: Account permissions → Starring: Read; Repository → Metadata: Read.
# Public StarVault site that share links should point to (friends can't reach your homelab).
SHARE_BASE_URL=
# Extra host names the server answers to, comma-separated, without port (*.ts.net, localhost and 127.0.0.1 always work).
ALLOWED_HOSTS=

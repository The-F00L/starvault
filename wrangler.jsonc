{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starvault",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the proxy invokes the Worker; everything else is a free static-asset request.
    "run_worker_first": ["/api/*"]
  },
  // Safeguard: per-IP limit on /api (per Cloudflare location, eventually consistent).
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
